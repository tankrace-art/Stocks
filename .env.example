# Medicube 트렌드 트래커 환경 설정
# 이 파일을 복사해서 .env 파일로 만들고 실제 값을 입력하세요

# Exolyt (TikTok 트렌드) 로그인 정보
EXOLYT_EMAIL=your_email@example.com
EXOLYT_PASSWORD=your_password

# SerpAPI - Google Trends 수집용 (pytrends 차단 대체)
# 무료 가입 후 API 키 발급: https://serpapi.com
# 무료 플랜: 월 100건 검색 (Google Trends 조회 포함)
SERPAPI_KEY=your_serpapi_key_here
